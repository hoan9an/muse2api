# ---- server ----
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
MUSE2API_LOG_LEVEL=INFO
# External base URL for media links; empty = derive from request
MUSE2API_PUBLIC_BASE=

# ---- auth ----
# Empty = auto-generate and store in data/api_key
MUSE2API_API_KEY=
# Empty = same as API key
MUSE2API_ADMIN_KEY=
# Dashboard sign-in password (default 201407@Hva). Change it on any shared host;
# empty disables password sign-in and leaves the admin key as the only way in.
MUSE2API_DASHBOARD_PASSWORD=201407@Hva

# ---- storage ----
MUSE2API_DATA_DIR=data
# Days of /v1/* request history kept in data/requests.db (pruned hourly)
MUSE2API_REQUEST_LOG_RETENTION_DAYS=14
# Days generated media files are kept in data/media (pruned hourly; 0 disables)
MUSE2API_MEDIA_RETENTION_DAYS=14

# ---- driver: mock | browser | http ----
MUSE2API_DRIVER=mock
# Upstream site base URL. Every upstream location the drivers address is derived
# from it, so a local fixture can stand in for muse.ai; empty = https://muse.ai
MUSE2API_SITE_URL=https://muse.ai

# ---- affinity + diagnostics ----
# Seconds a conversation stays pinned to the account that served it; visiting it
# again renews the binding, 0 = never expires (MUSE2API_POOL_STRATEGY=affinity)
# MUSE2API_AFFINITY_TTL=3600
# Weekly quota % above which an account keeps only its own conversations and is
# skipped for new ones; 0 disables the check
# MUSE2API_QUOTA_LOW_THRESHOLD_PCT=85
# Save data/debug/<id>/{meta.json,page.txt,page.png} when the browser driver fails,
# so a broken selector can be fixed from the page that broke it. Off by default:
# a capture holds whatever the account page was showing.
# MUSE2API_DEBUG_CAPTURE=false
# MUSE2API_DEBUG_CAPTURE_MAX_DIRS=50
# MUSE2API_DEBUG_CAPTURE_RETENTION_DAYS=3
# Days of weekly-quota samples kept in data/quota.db for the trend + forecast
# MUSE2API_QUOTA_HISTORY_RETENTION_DAYS=30

# browser driver
MUSE2API_CHROMIUM_PATH=
# Extra Chromium launch flags appended to the built-in list. Needed when the
# kernel blocks Chrome's sandbox (e.g. non-root user inside Docker):
# MUSE2API_CHROMIUM_FLAGS=--no-sandbox
# Persistent browser profile dir; empty = data/browser-profile
MUSE2API_BROWSER_PROFILE_DIR=
# Browser-only proxy. Leave empty when muse.ai is reachable directly.
MUSE2API_BROWSER_PROXY=
# MUSE2API_BROWSER_PROXY=socks5://127.0.0.1:10808
MUSE2API_CDP_PORT=19210
MUSE2API_HEADLESS=true
MUSE2API_PAGE_READY_TIMEOUT=45
# Pre-started threads kept per account: a new thread takes muse.ai 20-40s to
# answer, a started one ~5s. Each costs one extra short message. Needs
# MUSE2API_ACCOUNT_MAX_CONCURRENCY >= 2. 0 disables.
MUSE2API_WARM_THREADS=2

# ---- timeouts (seconds) ----
MUSE2API_CHAT_TIMEOUT=300
MUSE2API_FIRST_TOKEN_TIMEOUT=75
# SSE ': keepalive' comment interval while waiting for the first stream token;
# 0 disables (default): first token is awaited before the 200 response.
MUSE2API_STREAM_HEARTBEAT_INTERVAL=0
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600

# ---- account pool ----
# lru | round_robin | affinity
# affinity keeps one user on the same account so the hot page can be reused
MUSE2API_POOL_STRATEGY=affinity
MUSE2API_POOL_ACQUIRE_TIMEOUT=60
# Parallel requests per account; the browser driver opens one tab per slot.
# One account measured 8 images or 3 videos in parallel without errors.
MUSE2API_ACCOUNT_MAX_CONCURRENCY=4
# Seconds an account rests after an upstream error (timeouts excluded).
# Every parallel request on that account waits it out, so keep it short.
MUSE2API_ACCOUNT_COOLDOWN=30
MUSE2API_MAX_FAILOVER=2

# ---- background removal (images with background="transparent") ----
# Needs: pip install -e '.[matting]'. birefnet-general = best, birefnet-general-lite = faster
MUSE2API_MATTING_MODEL=birefnet-general

# ---- session keepalive ----
MUSE2API_KEEPALIVE_ENABLED=true
MUSE2API_KEEPALIVE_INTERVAL=600

# Seconds to wait for a woken VM to report RUNNING
# MUSE2API_WAKE_CONFIRM_S=20
# How long a quota reading is reused (seconds)
# MUSE2API_QUOTA_CACHE_S=1800
